{
    "version": 2,
    "builds": [
      {
        "src": "dist/ot_click/index.html",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/ot_click/assets/(.*)",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/ot_click/.*",
        "dest": "/ot_click/index.html"
      }
    ]
  }